
# FinalTake - Local Development Configuration

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=finaltake_user
DB_NAME=finaltake_db

# MySQL Password
# Replace with your own local MySQL password
DB_PASSWORD=your_mysql_password_here

# Flask Authentication
# Generate a unique secret key for your environment
FLASK_SECRET_KEY=replace_with_your_generated_secret_key

# Flask Session Configuration
SESSION_COOKIE_SECURE=false
